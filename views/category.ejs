<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
  </head>

  <body>
    <h1><%= category.name %></h1>
    <p><%= category.description %></p>

    <h2>Horses in this category</h2>
  
    <ul>
      <% items.forEach(function(item) { %>
        <li>
          <a href="/items/<%= item.id %>"><%= item.name %></a> — $<%= item.price %>
        </li>
      <% }); %>
    </ul>

    <a href="/">Back to categories</a>
  </body>
</html>