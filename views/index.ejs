<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
  </head>

  <body>
    <h1><%= title %></h1>

    <ul>
      <% categories.forEach(function(category) { %>
        <li>
          <a href="/categories/<%= category.id %>"><%= category.name %></a>
        </li>
      <% }); %>
    </ul>
  </body>
</html>